+{% extends "base.html" %}
+{% block title %}Faculty Dashboard{% endblock %}
+{% block content %}
+<h1>Faculty Dashboard</h1>
+<p>Manage grades and absences for your assigned teaching records.</p>
+{% for sid, name, module, year, semester in assignments %}
+<div class="card mt-2">
+  <div class="card-header">{{ name }} · {{ module }} · {{ year }} S{{ semester }}</div>
+  {% for record in records[sid] %}
+    {% if record.module == module and record.academic_year == year and record.semester == semester %}
+    <p>Current grade: {{ record.grade }}/20 · Absences: {{ record.absences }}</p>
+    {% endif %}
+  {% endfor %}
+  <form method="post" action="{{ url_for('faculty_dashboard') }}">
+    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
+    <input type="hidden" name="student_id" value="{{ sid }}">
+    <input type="hidden" name="module_name" value="{{ module }}">
+    <input type="hidden" name="academic_year" value="{{ year }}">
+    <input type="hidden" name="semester" value="{{ semester }}">
+    <div class="grid">
+      <div class="form-group"><label>Grade (0–20)<input type="number" name="grade" min="0" max="20" step="0.01" required></label></div>
+      <div class="form-group"><label>Absences<input type="number" name="absences" min="0" required></label></div>
+    </div>
+    <button class="btn" type="submit">Save assigned record</button>
+  </form>
+</div>
+{% else %}
+<p>No teaching assignments yet. Contact the administrator.</p>
+{% endfor %}
+{% endblock %}
