+    def db(self):
+        # closing plus transaction avoids leaving Windows SQLite file handles open.
+        from contextlib import contextmanager, closing
+        @contextmanager
+        def connection():
+            with closing(sqlite3.connect(app.config['DATABASE'])) as conn, conn:
+                yield conn
+        return connection()
